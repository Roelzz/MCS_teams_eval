# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# File sink (rotates at 10 MB, keeps 7 days). Blank disables file logging.
LOG_FILE=logs/teams-eval.log

# ── Azure AD (delegated, interactive browser login) ──────────────────────────
# App registration produced/extended by setup_app.py (needs Graph + Power Platform scopes)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=

# ── Teams channel (Microsoft Graph) polling ──────────────────────────────────
TEAMS_POLL_INTERVAL_S=1.5
TEAMS_POLL_TIMEOUT_S=60
# Quiet window: how long to wait after the last bot message before treating the turn as complete
TEAMS_QUIET_WINDOW_S=4
# Delay between Graph calls to avoid throttling
TEAMS_RATE_DELAY_S=1.0
# Wait (seconds) after sending a Teams prompt before polling for the reply — the eval never retries
# before this. The eval runs one sample at a time (the Teams chat is shared), so this also paces
# successive turns and prevents flooding. Overridable per-run on the Run page.
TEAMS_TURN_WAIT_S=10
# Hard per-channel timeout (seconds). Caps how long one Direct/Teams call may run before it is
# aborted and recorded as a channel error instead of wedging the whole eval. Direct-to-Engine
# streaming has no built-in timeout, so this is the safety net.
CHANNEL_TIMEOUT_S=90
# Optional best-effort context reset commands sent before each sample (comma-separated)
# e.g. /debug clearstate,/debug clearhistory   (leave empty to disable)
TEAMS_RESET_COMMANDS=

# ── Repeats & agreement (non-determinism) ────────────────────────────────────
DEFAULT_REPEATS=1
DEFAULT_AGREEMENT_THRESHOLD=0.8

# ── Multi-agent runs ─────────────────────────────────────────────────────────
# When several agents are selected on the Run page they evaluate in parallel (each agent has its
# own Teams chat, so this is safe). Cap how many run at once.
MAX_PARALLEL_AGENTS=3

# ── Comparison toggles ───────────────────────────────────────────────────────
COMPARE_SEMANTIC=true
COMPARE_STRUCTURED=true
COMPARE_CITATIONS=true
COMPARE_CARDS=true
COMPARE_SUGGESTED=true
# Match policy: which layers must agree for a sample to "match" — any of: normalized,semantic
MATCH_POLICY=normalized,semantic

# ── Judge model (semantic comparison + quality grading) ──────────────────────
# Inspect model string. Examples:
#   openai/gpt-4o
#   azureai/gpt-4o           (Azure AI Foundry / Azure OpenAI)
JUDGE_MODEL=openai/gpt-4o

# OpenAI
OPENAI_API_KEY=

# Azure AI Foundry / Azure OpenAI (used when JUDGE_MODEL starts with azureai/)
AZUREAI_OPENAI_API_KEY=
AZUREAI_OPENAI_BASE_URL=
AZUREAI_OPENAI_API_VERSION=2024-06-01
